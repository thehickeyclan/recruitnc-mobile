{
  "expo": {
    "name": "NC United",
    "slug": "recruitnc",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recruitnc",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1628",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ncunited.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ncunited.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1628",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Show wrestling clubs near you on the map."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27d86797-0b08-4142-9095-e54eaff25916"
      }
    },
    "owner": "nc-united",
    "updates": {
      "url": "https://u.expo.dev/27d86797-0b08-4142-9095-e54eaff25916",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
